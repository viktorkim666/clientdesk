# The app's own canonical URL, used to build absolute links (invite emails,
# OAuth redirects) instead of trusting request headers.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase local stack (values from `pnpm supabase status` after `pnpm supabase start`)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google OAuth (leave empty to keep the Google sign-in button disabled)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Resend (leave empty locally and in CI to use the console email sender)
RESEND_API_KEY=

# Supabase secret key, for server-only billing code that bypasses RLS (leave
# empty locally and in CI to keep the billing page reporting itself as not
# configured)
SUPABASE_SECRET_KEY=

# Stripe test mode (leave empty locally and in CI; see README for setup)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
